# Local access to your own Intervals.icu data (report.py --direct): set ONE of these.
# Personal API key from Intervals.icu → Settings → Developer Settings:
ICU_API_KEY=
# Or an Intervals.icu OAuth access token (used first when both are set):
ICU_OAUTH=

# Montis hosted-service maintainer access only.
# Not required for normal local engine execution.
# MONTIS_INTERNAL_KEY=
# MONTIS_WORKER_URL=
# MONTIS_STAGING_WORKER_URL=